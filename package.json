{
	"name": "pi-web",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Web UI for the pi coding agent — dsh-look shell driven by the official pi SDK without modifying pi",
	"scripts": {
		"dev": "next dev -H 127.0.0.1 -p 30141",
		"build": "next build --webpack",
		"start": "node bin/piweb.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test && npm run build",
		"update:pi": "npm install --save-exact @earendil-works/pi-coding-agent@latest && npm run check"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"highlight.js": "^11.11.1",
		"next": "16.3.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.2.2",
		"typescript": "^5",
		"vitest": "5.0.0"
	},
	"engines": {
		"node": ">=22"
	}
}
