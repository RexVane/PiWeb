{
	"name": "@rexvane/piweb",
	"version": "0.3.39",
	"license": "MIT",
	"type": "module",
	"description": "Self-hosted web UI for Pi Coding Agent: AI coding in your browser with workspaces, file diffs, MCP, session import and mobile access.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RexVane/PiWeb.git"
	},
	"homepage": "https://github.com/RexVane/PiWeb#readme",
	"bugs": {
		"url": "https://github.com/RexVane/PiWeb/issues"
	},
	"keywords": [
		"piweb",
		"pi",
		"pi-coding-agent",
		"pi-web-ui",
		"coding-agent",
		"ai-coding-agent",
		"coding-assistant",
		"web-ui",
		"self-hosted",
		"mcp",
		"model-context-protocol",
		"session-management",
		"mobile",
		"nextjs",
		"typescript",
		"cli"
	],
	"bin": {
		"piweb": "bin/piweb.js"
	},
	"files": [
		"bin",
		"src",
		"scripts",
		"public",
		"assets",
		"next.config.ts",
		"tsconfig.json",
		"postcss.config.mjs",
		"THIRD-PARTY-NOTICES.md",
		".next",
		"!.next/cache",
		"!.next/trace*",
		"!.next/diagnostics",
		"!scripts/testing/lint"
	],
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"build:release": "node scripts/release.mjs",
		"postinstall": "node scripts/postinstall.mjs",
		"prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run verify:package",
		"start": "node bin/piweb.js",
		"web": "node bin/pi.js web",
		"typecheck": "tsc --noEmit",
		"lint": "node scripts/testing/lint/run.mjs",
		"verify:package": "node scripts/verify-package.mjs",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test && npm run build",
		"sync:provider-icons": "node scripts/sync-provider-icons.mjs",
		"sync:file-icons": "node scripts/sync-file-icons.mjs",
		"update:pi": "node scripts/release.mjs --update-pi"
	},
	"dependencies": {
		"@earendil-works/chord": "1.7.0",
		"@earendil-works/pi-agent-core": "1.7.0",
		"@earendil-works/pi-ai": "1.7.0",
		"@earendil-works/pi-codemode": "1.7.0",
		"@earendil-works/pi-coding-agent": "1.7.0",
		"@earendil-works/pi-mcp": "1.7.0",
		"@earendil-works/pi-telemetry": "1.7.0",
		"@earendil-works/pi-tui": "1.7.0",
		"@lobehub/icons-static-svg": "^1.95.0",
		"@tailwindcss/postcss": "^4.2.2",
		"@types/node": "^26",
		"@types/proper-lockfile": "4.1.4",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"highlight.js": "^11.11.1",
		"ignore": "7.0.8",
		"jsonc-parser": "3.3.1",
		"next": "16.4.5",
		"postcss": "^8.5.26",
		"proper-lockfile": "4.1.2",
		"qrcode": "^1.5.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.2.2",
		"typebox": "1.3.27",
		"typescript": "^7",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@vitest/coverage-v8": "5.0.5",
		"jsdom": "30.0.1",
		"material-icon-theme": "^5.38.1",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"optionalDependencies": {
		"koffi": "^3.3.8"
	}
}
