{
	"name": "pi-web",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Web UI for the pi coding agent - dsh-look shell driven by the official pi SDK without modifying pi",
	"bin": {
		"pi": "bin/pi.js",
		"piweb": "bin/piweb.js"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node --max-old-space-size=8192 node_modules/next/dist/bin/next build --webpack",
		"start": "node bin/piweb.js",
		"web": "node bin/pi.js web",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test && npm run build",
		"sync:provider-icons": "node scripts/sync-provider-icons.mjs",
		"update:pi": "npm install --save-exact @earendil-works/pi-coding-agent@latest @earendil-works/pi-ai@latest && npm run sync:provider-icons && npm run check"
	},
	"dependencies": {
		"@automann/maple-mono-cn": "^7.9.2",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@lobehub/icons-static-svg": "^1.95.0",
		"highlight.js": "^11.11.1",
		"next": "16.3.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.2.2",
		"typescript": "^7",
		"vitest": "5.0.0"
	},
	"engines": {
		"node": ">=22"
	}
}
